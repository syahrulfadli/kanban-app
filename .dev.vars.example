# Salin file ini menjadi .dev.vars untuk pengembangan lokal.
# Buat secret acak dengan: openssl rand -base64 32
BETTER_AUTH_SECRET="ganti-dengan-secret-acak"
BETTER_AUTH_URL="http://localhost:5173"

# Opsional — kosongkan kalau belum mendaftarkan OAuth app.
# Login email/password tetap berfungsi tanpa ini.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Notifikasi push. Buat sepasang dengan: npm run vapid:keys
# Kosongkan kalau belum perlu — aplikasinya tetap jalan, sakelar
# notifikasinya saja yang tidak muncul.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Alamat kontak yang dilihat push service kalau kiriman kita bermasalah.
# Boleh mailto: atau https:. Kosong = memakai BETTER_AUTH_URL.
VAPID_SUBJECT=""

# Admin panel. Email di sini SELALU admin aplikasi dan tidak bisa dicabut
# lewat panel — itulah pintu daruratnya. Pisahkan dengan koma.
# Kosong berarti belum ada seorang pun yang bisa membuka panelnya.
ADMIN_EMAILS=""
